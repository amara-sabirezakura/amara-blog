---
import FAB from "@components/atoms/action/FAB.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { resolveDeviceClasses } from "@utils/fab-responsive";
import { url } from "@utils/url-utils";
import stylus from "stylus";
import { fabConfig, resolveLive2DOptions } from "@/config";

/**
 * Live2D 桌面小人（桌宠）：挂在持久外壳上的可选装饰层，默认可见、可点开关收起。
 *
 * 零额外负担（见 docs/on-demand-loading.md）：
 * - L1 短路：关闭或未配置 modelPath 时不输出任何节点（SSR 零 DOM）；
 * - L2/L3 样式隔离：样式源码在此构建期编译后以 `<style is:inline>` 输出，
 *   Astro CSS 管线看不到它，关闭时 dist 里也没有这份 CSS；
 * - L4 按需加载：只有「需要显示小人」时才动态 import 运行时
 *   （pixi + pixi-live2d-display + Cubism Core）并拉取模型。
 *
 * 默认可见：SSR 直接以 loading 态输出，脚本接手后立刻装载（失败则落回收起态）。
 * 模型是 38MB 级静态资源，默认可见意味着访客一进页面就要为它付带宽与内存 ——
 * 站点配置里关掉 `enable` 即可整体回到零成本状态。收起后不做任何持久化，
 * 下次加载仍按「默认可见」呈现。
 */
const options = resolveLive2DOptions();

if (!options) {
	return null;
}

const { side, size, framing, zoom, devices, credit, pauseOnReducedMotion } =
	options;

// 触发按钮与 FAB 列对齐：FAB 的偏移量是写在 #floating-controls 行内样式上的 CSS 变量，
// 组件外部读不到，所以这里用同一份 fabConfig 复算一遍，保证两者同列、同一间距。
// 触发器占的是「FAB 列里返回顶部按钮正上方那一格」，因此要求该列在视口下沿只露出返回顶部
// 一项（主题默认在 lg 及以上成立）；更窄视口若还有目录/首页等按钮，需把 devices 收到 desktop。
const fabInlineOffset = fabConfig.offset?.right ?? "var(--m3e-space-6)";
const fabBottomOffset = fabConfig.offset?.bottom ?? "var(--m3e-space-8)";
// FAB 按钮直径，与 FloatingActionButton → FAB 的 size 档一一对应
const fabButtonSize = fabConfig.size === "small" ? "2.5rem" : "3.5rem";
// 画框横向让开 FAB 列：右边缘停在悬浮按钮左侧一个间距处，避免两者叠在一起
const fabClearance = `calc(${fabInlineOffset} + ${fabButtonSize} + var(--m3e-space-2))`;

// 站内 public 路径经 url() 补站点 base；完整远程 URL 原样使用
const modelUrl = /^[a-z][a-z0-9+.-]*:/i.test(options.modelPath)
	? options.modelPath
	: url(options.modelPath);

const live2dStylus = `/* ==========================================================================
	   Live2D 桌面小人（最小装饰层，默认收起）
	   令牌规范：全部消费 M3E 语义令牌，跟随明暗与主题色
	   注意：本样式以 <style is:inline> 输出（不进入 Astro CSS 管线，见
	   docs/on-demand-loading.md §L3），因此根元素刻意不写 display ——
	   响应式显隐一律交给 Tailwind 类（内联样式无层，会压过 @layer utilities）。
	   展开/收起状态一律由 [data-live2d-state] 驱动，样式只负责显隐，不参与状态机。
	   ========================================================================== */

	.m3-live2d-pet
		/* 整层铺满视口、全透明且不吃指针：只为给两个子元素提供「以视口为基准」的定位参考 */
		position: fixed
		inset: 0
		z-index: 40
		pointer-events: none

		&--right
			.m3-live2d-pet__trigger
				right: var(--live2d-pet-inline)

			.m3-live2d-pet__panel
				right: var(--live2d-pet-panel-inline)

		&--left
			.m3-live2d-pet__trigger
				left: var(--live2d-pet-inline)

			.m3-live2d-pet__panel
				left: var(--live2d-pet-panel-inline)

		&__panel
			/* 纵向与开关解耦：画框中心正对浏览器窗口下沿，下半身交给窗口边缘去裁
			   （模型仍按 full 取景整体渲染，不做任何内部裁切）。
			   纵向：中心贴底 => 底边 = 自身高度的一半落到视口外 */
			position: absolute
			bottom: calc(-0.5 * var(--live2d-pet-size))
			/* 宽度锁到画框尺寸：绝对定位下若不加约束，标注块的超长许可文案会把整列撑宽 */
			width: var(--live2d-pet-size)
			display: none
			flex-direction: column
			align-items: stretch
			gap: var(--m3e-space-2)
			pointer-events: auto

		&__stage
			position: relative
			width: var(--live2d-pet-size)
			height: var(--live2d-pet-size)
			pointer-events: auto
			cursor: pointer

			canvas
				display: block
				width: 100%
				height: 100%

		&__loading
			position: absolute
			inset: 0
			display: none
			flex-direction: column
			align-items: center
			justify-content: center
			gap: var(--m3e-space-2)
			border-radius: var(--shape-corner-l)
			background: var(--surface-container-high)
			color: var(--on-surface-variant)
			font: var(--m3e-type-label-small)
			text-align: center

		&__credit
			/* 宽度收到画框的 60%：信息块不再横铺一整排，改为贴在小人上方居中 */
			align-self: center
			width: 60%
			padding: var(--m3e-space-2) var(--m3e-space-3)
			border: 1px solid var(--outline-variant)
			border-radius: var(--shape-corner-m)
			background: var(--surface-container-high)
			color: var(--on-surface)
			font: var(--m3e-type-label-small)
			/* 显隐只做透明度/可见性过渡：盒子本身始终占位，小人不会被顶得跳动 */
			transition: opacity var(--m3e-duration-medium) var(--m3e-easing-standard),
			            visibility var(--m3e-duration-medium) var(--m3e-easing-standard)

			> p
				margin: 0 0 var(--m3e-space-1)
				color: var(--on-surface-variant)

			dl
				display: grid
				grid-template-columns: auto minmax(0, 1fr)
				gap: var(--m3e-space-1) var(--m3e-space-2)
				margin: 0

			dt
				color: var(--on-surface-variant)

			dd
				margin: 0
				overflow-wrap: anywhere

			a
				color: var(--primary)

		&__trigger
			/* 本体是 FAB 原子（与右下角悬浮按钮同款、同尺寸），
			   这一层只负责定位：与 FAB 同列、落在「返回顶部」按钮正上方 */
			position: absolute
			bottom: var(--live2d-pet-trigger-bottom)
			pointer-events: auto

		&__logo
			display: block
			width: 1.6rem
			height: auto

	.m3-live2d-pet[data-live2d-state="loading"] .m3-live2d-pet__panel,
	.m3-live2d-pet[data-live2d-state="expanded"] .m3-live2d-pet__panel
		display: flex

	.m3-live2d-pet[data-live2d-state="loading"] .m3-live2d-pet__loading
		display: flex

	/* 模型信息框：出现时先亮 2s，指针停在小人身上时保持，离开后再等 2s 收起（见脚本） */
	.m3-live2d-pet[data-live2d-credit-state="hidden"] .m3-live2d-pet__credit
		opacity: 0
		visibility: hidden`;

const live2dStyles = await new Promise<string>((resolve, reject) => {
	stylus.render(live2dStylus, (error, css) => {
		if (error) reject(error);
		else resolve(css);
	});
});
---

<aside
	id="live2d-pet"
	class:list={[
		"m3-live2d-pet",
		`m3-live2d-pet--${side}`,
		resolveDeviceClasses(devices),
	]}
	aria-label={i18n(I18nKey.live2dPet)}
	data-live2d-model={modelUrl}
		data-live2d-framing={framing}
		data-live2d-zoom={String(zoom)}
	data-live2d-hint={i18n(I18nKey.live2dHint)}
	data-live2d-state="loading"
	data-live2d-credit-state="shown"
	data-live2d-pause-on-reduced={String(pauseOnReducedMotion)}
	style={`--live2d-pet-size: ${size}; --live2d-pet-inline: ${fabInlineOffset}; --live2d-pet-panel-inline: ${fabClearance}; --live2d-pet-trigger-bottom: calc(${fabBottomOffset} + ${fabButtonSize} + var(--m3e-space-2))`}
>
	<div id="live2d-pet-panel" class="m3-live2d-pet__panel" data-live2d-panel>
		{credit && (
			<div class="m3-live2d-pet__credit" data-live2d-credit>
				<p>{i18n(I18nKey.live2dCredit)}</p>
				<dl>
					{credit.title && (
						<>
							<dt>{i18n(I18nKey.live2dCreditModel)}</dt>
							<dd>
								{credit.titleUrl ? (
									<a
										href={credit.titleUrl}
										target="_blank"
										rel="noopener noreferrer"
									>
										{credit.title}
									</a>
								) : (
									credit.title
								)}
							</dd>
						</>
					)}
					{credit.author && (
						<>
							<dt>{i18n(I18nKey.live2dCreditAuthor)}</dt>
							<dd>
								{credit.authorUrl ? (
									<a
										href={credit.authorUrl}
										target="_blank"
										rel="noopener noreferrer"
									>
										{credit.author}
									</a>
								) : (
									credit.author
								)}
							</dd>
						</>
					)}
					{credit.license && (
						<>
							<dt>{i18n(I18nKey.live2dCreditLicense)}</dt>
							<dd>{credit.license}</dd>
						</>
					)}
					{credit.url && (
						<>
							<dt>{i18n(I18nKey.live2dCreditSource)}</dt>
							<dd>
								<a href={credit.url} target="_blank" rel="noopener noreferrer">
									{credit.url}
								</a>
							</dd>
						</>
					)}
				</dl>
			</div>
		)}

		<div class="m3-live2d-pet__stage" data-live2d-stage>
			<div class="m3-live2d-pet__loading" role="status" aria-live="polite">
				<!-- 加载指示由运行时按需挂载（LoadingIndicator 原子），此处只留挂载点：
				     收起态因此连指示器的 JS 都不带，也不会留一个隐藏的空转 rAF 循环 -->
				<span data-live2d-spinner></span>
				<span>{i18n(I18nKey.live2dLoading)}</span>
			</div>
		</div>
	</div>

	<!-- 触发器沿用 FAB 原子（与右下角悬浮按钮同款），外层只承担定位与点击命中；
	     展开态语义（aria-expanded / aria-controls）由脚本挂到里面的真实 <button> 上。
	     图标是自绘的「L2D」交织字：斜体粗描边、2 与 D 交错咬合（描摹自参考图），
	     currentColor 跟随 FAB 前景色，不引外部图片、不发请求，SSR 也照样画得出来。 -->
	<div class="m3-live2d-pet__trigger" data-live2d-trigger>
		<FAB
			client:load
			variant="primary"
			size={fabConfig.size ?? "regular"}
			lowered={true}
			ariaLabel={i18n(I18nKey.live2dPet)}
		>
			<svg
				class="m3-live2d-pet__logo"
				viewBox="0 0 26 26"
				fill="none"
				stroke="currentColor"
				stroke-width="2.4"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M7.2 4.7 4.7 12.9h4.3" />
				<path d="M10.5 11.1c0-3.7 5.5-4.7 6-1.5.4 2.4-4.1 5-8.1 6.8h7.3" />
				<path d="M15.7 11.9h4.7c2 .2 2.5 3.6 1.5 5.6-.8 1.7-2.5 2.3-4.9 2.3h-4.4" />
			</svg>
		</FAB>
	</div>
</aside>

<style is:inline set:html={live2dStyles}></style>

<script>
	let runtimePromise: Promise<typeof import("@components/organisms/live2d/live2d-pet")> | null =
		null;

	function loadRuntime() {
		runtimePromise ??= import("@components/organisms/live2d/live2d-pet");
		return runtimePromise;
	}

	function triggerOf(host: HTMLElement) {
		return host.querySelector<HTMLElement>("[data-live2d-trigger]");
	}

	/** 展开态语义挂在里层真正的 <button>（FAB 原子）上，外层只做定位与点击命中 */
	function controlOf(host: HTMLElement) {
		const trigger = triggerOf(host);
		return trigger?.querySelector<HTMLElement>("button") ?? trigger;
	}

	function setExpanded(host: HTMLElement, expanded: boolean) {
		controlOf(host)?.setAttribute("aria-expanded", String(expanded));
	}

	/**
	 * 模型信息框的显隐节拍：出现时先亮 CREDIT_HOLD_MS，指针停在小人（画框或信息框）上就保持，
	 * 离开后再等 CREDIT_HOLD_MS 收起 —— 让人看得见出处，又不长期占着版面。
	 */
	const CREDIT_HOLD_MS = 2000;
	const creditTimers = new WeakMap<HTMLElement, number>();

	function setCreditVisible(host: HTMLElement, visible: boolean): void {
		host.dataset.live2dCreditState = visible ? "shown" : "hidden";
	}

	function scheduleCreditHide(host: HTMLElement): void {
		const timer = creditTimers.get(host);
		if (timer !== undefined) window.clearTimeout(timer);
		creditTimers.set(
			host,
			window.setTimeout(() => setCreditVisible(host, false), CREDIT_HOLD_MS),
		);
	}

	function flashCredit(host: HTMLElement): void {
		setCreditVisible(host, true);
		scheduleCreditHide(host);
	}

	async function expandPet(host: HTMLElement) {
		const state = host.dataset.live2dState;
		if (state === "expanded" || state === "loading") return;

		host.dataset.live2dState = "loading";
		setExpanded(host, true);
		flashCredit(host);

		try {
			const { mountLive2DPet } = await loadRuntime();
			await mountLive2DPet(host);
		} catch (error) {
			console.error("[Shirone Live2D] 运行时加载失败：", error);
		}

		// 载入失败、或装载途中用户已收起：都回落到收起态，不留半截 UI
		const mounted = host.dataset.live2dMounted === "true";
		host.dataset.live2dState = mounted ? "expanded" : "collapsed";
		setExpanded(host, mounted);
	}

	async function collapsePet(host: HTMLElement) {
		if (host.dataset.live2dState === "collapsed") return;

		host.dataset.live2dState = "collapsed";
		setExpanded(host, false);

		const { unmountLive2DPet } = await loadRuntime();
		unmountLive2DPet(host);
	}

	function bindPet(host: HTMLElement) {
		if (host.dataset.live2dBound === "true") return;
		host.dataset.live2dBound = "true";

		controlOf(host)?.setAttribute("aria-controls", "live2d-pet-panel");
		setExpanded(host, host.dataset.live2dState !== "collapsed");

		triggerOf(host)?.addEventListener("click", () => {
			if (host.dataset.live2dState === "collapsed") void expandPet(host);
			else void collapsePet(host);
		});

		// 信息框的触发条件：指针压在小人身上（画框或信息框本身）就一直显示，
		// 也正是这样才点得到框里的两条外链 —— 不然指针一挪过去框就没了。
		const panel = host.querySelector<HTMLElement>("[data-live2d-panel]");
		panel?.addEventListener("mouseenter", () => {
			const timer = creditTimers.get(host);
			if (timer !== undefined) window.clearTimeout(timer);
			setCreditVisible(host, true);
		});
		panel?.addEventListener("mouseleave", () => scheduleCreditHide(host));

		// 首屏（含重新展开）先亮满一个节拍
		flashCredit(host);

		// Esc 收起：只在展开态响应（<button> 自带的 Enter/Space 已覆盖展开）
		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return;
			if (host.dataset.live2dState === "collapsed") return;
			void collapsePet(host);
		});
	}

	function setupAllLive2DPets() {
		for (const host of document.querySelectorAll<HTMLElement>(
			"[data-live2d-model]",
		)) {
			bindPet(host);
		}
	}

	/** 默认可见：SSR 以 loading 态输出，脚本接手后立即装载；装载失败就落回收起态。 */
	async function mountVisiblePets() {
		for (const host of document.querySelectorAll<HTMLElement>(
			"[data-live2d-model]",
		)) {
			if (host.dataset.live2dState !== "loading") continue;
			if (host.dataset.live2dMounted === "true") continue;

			try {
				const { mountLive2DPet } = await loadRuntime();
				await mountLive2DPet(host);
			} catch (error) {
				console.error("[Shirone Live2D] 运行时加载失败：", error);
			}

			const mounted = host.dataset.live2dMounted === "true";
			host.dataset.live2dState = mounted ? "expanded" : "collapsed";
			setExpanded(host, mounted);
		}
	}

	setupAllLive2DPets();
	void mountVisiblePets();
	document.addEventListener("swup:content:replace", setupAllLive2DPets);
	document.addEventListener("swup:page:view", setupAllLive2DPets);
</script>
